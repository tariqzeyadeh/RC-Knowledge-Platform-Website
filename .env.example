# =============================================================================
# RC Knowledge Platform — environment variables
# =============================================================================

# --- Local development (default) ---
TURSO_DATABASE_URL=file:./data/local.db
# TURSO_AUTH_TOKEN is not needed for local SQLite

# --- Vercel production (required) ---
# Create a database at https://turso.tech (free tier works for demos).
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Tip: install the Turso integration in the Vercel dashboard — it sets both vars automatically.
